# Dependencies
node_modules/

# Build outputs
# NOTE: keep these anchored. A bare `lib/` also matches `packages/ui/src/lib/`
# (the library's *source*), which would silently drop it from git and the npm tarball.
/packages/ui/lib/
**/dist/
storybook-static/

# Expo
.expo/
expo-env.d.ts
# Generated native projects (regenerated by `expo prebuild`)
storybook/native/android/
storybook/native/ios/

# Storybook React Native (generated)
storybook.requires.ts
# Baked at storybook-generate time by scripts/bake-build-info.mjs (version + git sha)
storybook/native/.rnstorybook/build-info.ts

# Uniwind (generated type declarations for className autocomplete)
uniwind-types.d.ts

# Tests
coverage/

# Misc
*.log
.DS_Store
.env*
!.env.example

# Agents
.agent/

# repowise runtime data
.repowise/
!.repowise/mcp.json.example
.repowise-workspace/
.repowise-workspace.yaml

# repowise editor wiring (machine-specific absolute paths — regenerated by `repowise init`)
.mcp.json
.vscode/mcp.json